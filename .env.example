# Variáveis de Ambiente — LearnIt English
# Copie este arquivo para `.env` ou `.env.local`:

# Banco de dados (SQLite local para dev):
DATABASE_URL="file:./dev.db"

# Ou PostgreSQL (produção/remoto):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth secret (chave de criptografia de sessão):
AUTH_SECRET="sua-chave-secreta-aqui"
AUTH_URL="http://localhost:3000"
